{
  "name": "ark-agent-plan",
  "version": "1.0.0",
  "private": true,
  "description": "Volcengine Ark routes for DeepSeek Harness with the current Agent Plan catalog (Doubao Seed 2.1 / 2.0, Seed Evolving, DeepSeek V4.1 / V4, GLM-5.3, Kimi K3.1 / K2.8).",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
